# Copy to .env and edit. NEVER commit .env. Secrets here are read from the environment only.

# --- database (docker compose builds the URL from this password)
POSTGRES_PASSWORD=change-me-long-random
# Local (non-docker) mode uses SQLite by default:
# PROPGUARD_DATABASE_URL=sqlite:///./data/propguard.db

# --- owner access token for all mutating API calls (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
PROPGUARD_API_TOKEN=
PROPGUARD_PORT=8000

# --- execution safety. New installs are PAPER_ONLY. LIVE additionally needs:
#     `propguard acceptance` passing on this code + `propguard live enable --account ID --confirm "<phrase>"`
PROPGUARD_EXECUTION_MODE=PAPER_ONLY
PROPGUARD_ALLOW_LIVE=false

# --- logging
PROPGUARD_LOG_LEVEL=INFO
PROPGUARD_LOG_JSON=true

# --- rule monitoring
PROPGUARD_MONITOR_INTERVAL_S=3600
PROPGUARD_MONITOR_MIN_DELAY_PER_HOST_S=10
PROPGUARD_RULES_MAX_AGE_H=24
PROPGUARD_SEED_ON_START=true

# --- optional LLM assistance for changed-fragment interpretation (off by default: changes then require manual review)
PROPGUARD_LLM_PROVIDER=none
# ANTHROPIC_API_KEY=
# Model ids per tier are configuration, not code. Check current models/pricing before changing.
PROPGUARD_LLM_MODEL_CHEAP=claude-haiku-4-5
PROPGUARD_LLM_MODEL_STRONG=claude-opus-5-5
PROPGUARD_LLM_MONTHLY_BUDGET_USD=5

# --- optional notifications (core is messenger-agnostic)
# PROPGUARD_WEBHOOK_URL=
# PROPGUARD_TELEGRAM_BOT_TOKEN=
# PROPGUARD_TELEGRAM_CHAT_ID=
